<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="ltr" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/hub_symbol" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="◉" android:textSize="23sp" android:textColor="#F9A8D4" android:background="@drawable/widget_checkbox_background" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="11dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ARSHNAZ · QUICK ACTION" android:textColor="#A78BFA" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/hub_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Focus timer" android:textColor="#F8FAFC" android:textSize="19sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/hub_subtitle" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:maxLines="2" android:ellipsize="end" android:textColor="#94A3B8" android:textSize="12sp" />
    <Button android:id="@+id/hub_primary" android:layout_width="match_parent" android:layout_height="48dp" android:text="Start" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/widget_button_background" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/hub_action_one" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:textAllCaps="false" android:textColor="#DDD6FE" android:textSize="10sp" android:background="@drawable/widget_card_background" />
        <TextView android:layout_width="5dp" android:layout_height="1dp" />
        <Button android:id="@+id/hub_action_two" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:textAllCaps="false" android:textColor="#DDD6FE" android:textSize="10sp" android:background="@drawable/widget_card_background" />
        <TextView android:layout_width="5dp" android:layout_height="1dp" />
        <Button android:id="@+id/hub_action_three" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:minWidth="0dp" android:textAllCaps="false" android:textColor="#DDD6FE" android:textSize="10sp" android:background="@drawable/widget_card_background" />
    </LinearLayout>
</LinearLayout>
