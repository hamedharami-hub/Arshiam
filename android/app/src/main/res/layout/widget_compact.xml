<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/agenda_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="ltr" android:padding="14dp" android:background="#111827">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/agenda_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Today" android:textSize="18sp" android:textStyle="bold" android:textColor="#F8FAFC"/><TextView android:id="@+id/agenda_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 active" android:textColor="#C4B5FD" android:textSize="12sp"/><Button android:id="@+id/agenda_settings" android:layout_width="40dp" android:layout_height="40dp" android:text="⚙" android:textColor="#C4B5FD" android:background="@android:color/transparent"/></LinearLayout>
    <TextView android:id="@+id/agenda_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 shown · 0 completed" android:textColor="#94A3B8" android:textSize="10sp"/>
    <TextView android:id="@+id/agenda_summary" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="2" android:textColor="#F8FAFC" android:textSize="15sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal"><Button android:id="@+id/agenda_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:text="＋ Add task" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/widget_button_background"/><Button android:id="@+id/agenda_scope" android:layout_width="48dp" android:layout_height="44dp" android:text="↔" android:textColor="#C4B5FD" android:background="@android:color/transparent"/><Button android:id="@+id/agenda_refresh" android:layout_width="48dp" android:layout_height="44dp" android:text="↻" android:textColor="#C4B5FD" android:background="@android:color/transparent"/></LinearLayout>
    <TextView android:id="@+id/agenda_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#94A3B8" android:textSize="10sp"/>
</LinearLayout>
