<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/agenda_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="ltr" android:padding="16dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/agenda_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Today" android:textSize="21sp" android:textStyle="bold" android:textColor="#F2EFEA"/>
            <TextView android:id="@+id/agenda_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="0 shown · 0 completed" android:textSize="11sp" android:textColor="#A39E96"/>
        </LinearLayout>
        <TextView android:id="@+id/agenda_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="64dp" android:gravity="center" android:padding="8dp" android:text="0 active" android:textSize="12sp" android:textStyle="bold" android:textColor="#9AA3D6" android:background="@drawable/widget_card_background"/>
        <Button android:id="@+id/agenda_settings" android:layout_width="44dp" android:layout_height="44dp" android:minWidth="44dp" android:minHeight="44dp" android:text="⚙" android:textSize="19sp" android:textColor="#9AA3D6" android:background="@android:color/transparent" android:contentDescription="Widget settings"/>
    </LinearLayout>
    <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="6dp" android:background="#3A3632" android:importantForAccessibility="no"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/agenda_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="3dp"/>
        <TextView android:id="@+id/agenda_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="No tasks in this view" android:textColor="#A39E96" android:textSize="14sp"/>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/agenda_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:minWidth="0dp" android:minHeight="44dp" android:text="＋ Add task" android:textAllCaps="false" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/widget_button_background"/>
        <Button android:id="@+id/agenda_add_note" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="60dp" android:minHeight="44dp" android:text="＋ Note" android:textAllCaps="false" android:textSize="12sp" android:textStyle="bold" android:textColor="#9AA3D6" android:background="@drawable/widget_card_background" android:layout_marginStart="4dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:contentDescription="Add note"/>
        <Button android:id="@+id/agenda_scope" android:layout_width="52dp" android:layout_height="44dp" android:minWidth="52dp" android:minHeight="44dp" android:text="↔" android:textSize="18sp" android:textColor="#9AA3D6" android:background="@android:color/transparent" android:contentDescription="Change view"/>
        <Button android:id="@+id/agenda_refresh" android:layout_width="52dp" android:layout_height="44dp" android:minWidth="52dp" android:minHeight="44dp" android:text="↻" android:textSize="19sp" android:textColor="#9AA3D6" android:background="@android:color/transparent" android:contentDescription="Refresh widgets"/>
    </LinearLayout>
    <TextView android:id="@+id/agenda_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="10sp" android:textColor="#A39E96"/>
</LinearLayout>
