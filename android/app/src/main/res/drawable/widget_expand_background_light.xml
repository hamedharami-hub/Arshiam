<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#C9CDE6"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1.5dp" android:color="#4C5AA9"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#EFEBE4"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#9AA3D6"/>
        </shape>
    </item>
</selector>
