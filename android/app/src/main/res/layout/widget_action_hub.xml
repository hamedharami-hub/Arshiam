<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="ltr" android:padding="16dp" android:background="#111827">
    <TextView android:id="@+id/hub_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Focus timer" android:textColor="#F8FAFC" android:textSize="21sp" android:textStyle="bold" />
    <TextView android:id="@+id/hub_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:maxLines="2" android:ellipsize="end" android:textColor="#94A3B8" android:textSize="12sp" />
    <Button android:id="@+id/hub_primary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:text="Start" android:textAllCaps="false" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/widget_button_background" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/hub_action_one" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:textAllCaps="false" android:textColor="#C4B5FD" android:textSize="11sp" android:background="@drawable/widget_card_background" />
        <Button android:id="@+id/hub_action_two" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:textAllCaps="false" android:textColor="#C4B5FD" android:textSize="11sp" android:background="@drawable/widget_card_background" />
        <Button android:id="@+id/hub_action_three" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:textAllCaps="false" android:textColor="#C4B5FD" android:textSize="11sp" android:background="@drawable/widget_card_background" />
    </LinearLayout>
</LinearLayout>
